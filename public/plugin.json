      "cmds": ["端口进程", "端口清理", "kill port", "ports"]
    },
    {
      "code": "eypc-favorites",
      "explain": "文件夹和文件收藏",
      "cmds": ["文件收藏", "文件夹收藏", "favorites"]
    },
    {
      "code": "eypc-settings",
      "explain": "EyPc 设置",
      "cmds": ["EyPc设置", "eypc settings"]
    }
  ]
}
