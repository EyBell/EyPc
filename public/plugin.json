{
  "pluginName": "EyPc",
  "description": "跨平台 PC 能力调用工具",
  "author": "gdkmjd",
  "main": "index.html",
  "logo": "logo.png",
  "preload": "preload.js",
  "development": {
    "main": "http://127.0.0.1:8092/"
  },
  "pluginSetting": {
    "single": true,
    "height": 680
  },
  "features": [
    {
      "code": "eypc-main",
      "explain": "打开 EyPc",
      "cmds": ["EyPc", "PC工具", "电脑工具"]
    },
    {
      "code": "eypc-ports",
      "explain": "端口进程管理",
      "cmds": ["端口进程", "端口清理", "kill port", "ports"]
    },
    {
      "code": "eypc-mqtt",
      "explain": "MQTT WebSocket 快连",
      "cmds": ["MQTT", "mqtt websocket", "mqtt ws", "消息调试"]
    },
    {
      "code": "eypc-favorites",
      "explain": "文件夹和文件收藏",
      "cmds": ["文件收藏", "文件夹收藏", "favorites"]
    },
    {
      "code": "eypc-favorites-quick",
      "explain": "快速打开文件收藏",
      "cmds": ["文件快开", "快速文件", "quick favorites"]
    },
    {
      "code": "eypc-codex",
      "explain": "Codex 额度悬浮球设置",
      "cmds": ["Codex额度", "Codex悬浮球", "Codex quota"]
    },
    {
      "code": "eypc-codex-toggle",
      "explain": "显示/隐藏 Codex 悬浮球",
      "mainHide": true,
      "cmds": ["切换 Codex 悬浮球"]
    },
    {
      "code": "eypc-codex-activate",
      "explain": "进入 Codex 卡片",
      "mainHide": true,
      "cmds": ["进入 Codex 卡片", "直接展开 Codex 卡片", "Codex 多选", "Codex 会话操作"]
    },
    {
      "code": "eypc-codex-input",
      "explain": "打开 Codex 待输入任务",
      "mainHide": true,
      "cmds": ["Codex待输入", "打开 Codex 待输入任务", "Codex 待回复"]
    },
    {
      "code": "eypc-settings",
      "explain": "EyPc 设置",
      "cmds": ["EyPc设置", "eypc settings"]
    }
  ]
}
