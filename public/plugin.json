  "main": "index.html",
  "logo": "logo.svg",
  "preload": "preload.js",
  "development": {
    "main": "http://127.0.0.1:8092/"
  },
  "pluginSetting": {
    "single": true,
    "height": 680
  },
  "features": [
    {
      "code": "eypc-main",
