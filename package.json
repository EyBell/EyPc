{
  "name": "eypc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.0",
  "scripts": {
    "serve": "node scripts/prepare-utools-runtime.mjs && vite --host 127.0.0.1 --port 8092 --strictPort",
    "dev": "pnpm run serve",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "build": "pnpm run typecheck && vite build && node scripts/prepare-utools-runtime.mjs && pnpm run validate:utools",
    "validate:utools": "node scripts/validate-utools-runtime.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4174"
  },
  "dependencies": {
    "@lucide/vue": "^1.21.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "mqtt": "5.15.1",
    "vite": "^7.3.1",
    "vue": "^3.5.25"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6",
    "vue-tsc": "^3.1.8"
  }
}
