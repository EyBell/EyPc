{
  "name": "eypc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.0",
  "scripts": {
    "serve": "node scripts/prepare-utools-runtime.mjs --development && vite --host 127.0.0.1 --port 8092 --strictPort",
    "dev": "pnpm run serve",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "build": "pnpm run validate:contracts && pnpm run typecheck && vite build && node scripts/prepare-utools-runtime.mjs && pnpm run validate:utools",
    "generate:contracts": "node scripts/generate-companion-contracts.mjs",
    "validate:contracts": "node scripts/generate-companion-contracts.mjs --check",
    "sync:preloads": "pnpm run generate:contracts && node scripts/sync-utools-preloads.mjs",
    "verify": "pnpm run sync:preloads && pnpm run test && pnpm run build && pnpm run validate:mirrors",
    "validate:utools": "node scripts/validate-utools-runtime.mjs",
    "validate:mirrors": "node scripts/validate-committed-preload-mirrors.mjs",
    "probe:claude-code": "node scripts/probe-claude-code-runtime.mjs",
    "probe:claude-live-state": "node scripts/probe-claude-live-state-runtime.mjs",
    "probe:claude-open": "node scripts/probe-claude-open-runtime.mjs",
    "probe:claude-quota": "node scripts/probe-claude-quota-runtime.mjs",
    "probe:claude-quota-cache": "node scripts/probe-claude-quota-cache-runtime.mjs",
    "probe:claude-unread": "node scripts/probe-claude-unread-runtime.mjs",
    "probe:claude-unread-key": "node scripts/probe-claude-unread-key-runtime.mjs",
    "probe:runtime-diagnostics": "node scripts/probe-eypc-diagnostics-runtime.mjs",
    "validate:error-memory": "node scripts/validate-error-memory.mjs",
    "validate:requirements": "node scripts/validate-requirements.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4174"
  },
  "dependencies": {
    "@lucide/vue": "^1.21.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "koffi": "^2.16.3",
    "marked": "^18.0.7",
    "mqtt": "5.15.1",
    "vite": "^7.3.1",
    "vue": "^3.5.25"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.10.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6",
    "vue-tsc": "^3.1.8"
  }
}
